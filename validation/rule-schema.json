{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AndroDR SIGMA Rule",
  "type": "object",
  "required": [
    "title",
    "id",
    "status",
    "logsource",
    "detection",
    "level",
    "category"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^androdr-(\\d{3}|atom-[a-z-]+|corr-\\d{3})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "test",
        "production"
      ]
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "incident",
        "device_posture"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "report_safe_state": {
      "type": "boolean"
    },
    "logsource": {
      "type": "object",
      "required": [
        "product",
        "service"
      ],
      "properties": {
        "product": {
          "const": "androdr"
        },
        "service": {
          "type": "string",
          "enum": [
            "accessibility_audit",
            "app_scanner",
            "appops_audit",
            "battery_daily",
            "db_info",
            "device_auditor",
            "dns_monitor",
            "file_scanner",
            "network_monitor",
            "package_install_history",
            "platform_compat",
            "process_monitor",
            "receiver_audit",
            "timeline",
            "tombstone_parser",
            "wakelock_parser"
          ]
        }
      }
    },
    "detection": {
      "type": "object",
      "required": [
        "condition"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsepositives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "app_risk",
            "device_posture",
            "network"
          ]
        },
        "icon": {
          "type": "string"
        },
        "triggered_title": {
          "type": "string"
        },
        "safe_title": {
          "type": "string"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "none",
            "cve_list",
            "ioc_match",
            "permission_cluster"
          ]
        },
        "summary_template": {
          "type": "string"
        },
        "guidance": {
          "type": "string"
        }
      }
    }
  }
}
